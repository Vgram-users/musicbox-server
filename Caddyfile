# SITE_ADDRESS задаётся в .env: music.example.com
# Caddy сам получит и обновит HTTPS-сертификат Let's Encrypt.
{$SITE_ADDRESS:localhost} {
	request_body {
		max_size 60MB
	}

	# аудио отдаём как есть, Caddy умеет Range из коробки
	reverse_proxy api:8000

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 3
		}
		format console
	}
}
