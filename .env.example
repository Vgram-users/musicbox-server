# --- app ---
APP_NAME=Music Server
API_PREFIX=/api/v1

# --- database ---
# локально:
DATABASE_URL=sqlite:///./data/app.db
# прод (Neon/Supabase):
# DATABASE_URL=postgresql+psycopg2://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- security ---
# сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-please
ACCESS_TOKEN_TTL_MINUTES=43200

# --- storage: local | s3 ---
STORAGE_BACKEND=local
MEDIA_DIR=./data/media
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Cloudflare R2 (S3-совместимый)
# STORAGE_BACKEND=s3
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=music
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto

# --- регистрация ---
# true = только по инвайт-коду (scripts/invite.py), false = открытая
INVITE_ONLY=true

# --- misc ---
CORS_ORIGINS=*
MAX_UPLOAD_MB=50

# --- прокси для площадок (телефон слушает локальный API без VPN) ---
# HTTP/HTTPS-прокси:
# PROXY_URL=http://user:pass@proxy.example.com:8080
# SOCKS5 (нужен доп. пакет: pip install "requests[socks]"):
# PROXY_URL=socks5://user:pass@proxy.example.com:1080
PROXY_URL=
